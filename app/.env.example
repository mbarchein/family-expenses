# The /exec URL of the Apps Script web app deployment. See DEPLOY.md §4.
VITE_API_URL=https://script.google.com/macros/s/XXXXXXXX/exec

# OAuth 2.0 Client ID (Web application) from Google Cloud Console. The same
# value has to be in the Config tab of the spreadsheet under oauth_client_id,
# or the backend will reject every token. See DEPLOY.md §3.
VITE_GOOGLE_CLIENT_ID=XXXXXXXX.apps.googleusercontent.com
