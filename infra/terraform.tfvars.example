# Copy to terraform.tfvars and fill in. That file is gitignored: it holds a
# Vercel token, a GitHub PAT, a Cloudflare token and a clasp refresh token.

# ── Credentials for Terraform ───────────────────────────────
vercel_token         = ""
github_token         = ""
cloudflare_api_token = ""

# Only if the Vercel account has no team and the project's team_id comes back
# null. `vercel whoami --token <token>` prints the account id.
# vercel_org_id = ""

# ── From the manual half, DEPLOY.md steps 2 to 6 ────────────
google_oauth_client_id    = "XXXXXXXX.apps.googleusercontent.com"
apps_script_exec_url      = "https://script.google.com/macros/s/XXXXXXXX/exec"
apps_script_id            = ""
apps_script_deployment_id = ""

# The whole contents of ~/.clasprc.json. Use a heredoc and paste the file
# verbatim — its own double quotes, its newlines, everything. Escaping that JSON
# into a quoted HCL string by hand is an afternoon lost to backslashes, and
# rewriting its quotes as single ones breaks twice over: HCL has no single-quoted
# string, and CI writes this straight back out to a file that clasp parses as
# JSON.
#
# The one sequence a heredoc still interprets is ${...}. A clasp session has
# none; if yours somehow does, double the dollar: $${.
#
# To keep the refresh token out of this file altogether, pass it through the
# environment instead and leave the heredoc out:
#   export TF_VAR_clasprc_json="$(cat ~/.clasprc.json)"
clasprc_json = <<-EOT
{"tokens":{"default":{"client_id":"...","refresh_token":"..."}}}
EOT
